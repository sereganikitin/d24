# Скопировать в .env — и локально (node --env-file=.env src/server.js),
# и на сервере (ecosystem.config.cjs подключает этот же .env через
# --env-file). Сам .env в .gitignore, не коммитится.

LLM_PROVIDER=yandexgpt
PORT=3011

# YandexGPT (провайдер по умолчанию — у Gemini/Claude нет России в
# списке доступных регионов API, см. README.md). Ключ и folder id — в
# aistudio.yandex.ru: создать API-ключ, folder id скопировать наводкой
# на имя папки вверху экрана консоли.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# Синтез речи (POST /tts) — тот же ключ/folder, что и выше.
# Документация Yandex по этому эндпоинту (v1 tts:synthesize) не
# совпадает с реальным API — проверено вживую 2026-09-06 через GET /tts.
# Реально работают: jane, marina, alena, oksana, omazh (женские),
# filipp, ermil, zahar, madi_ru (мужские, казахский акцент в русском).
# Остальные из доков (dasha, julia, lera, masha, alexander, kirill,
# anton, saule_ru, zamira_ru) — отвечают 400 "unsupported voice"; ещё
# несколько (alyss, nastya, sasha, kostya, zhenya) зависают без ответа.
# Перед тем как ставить сюда голос не из этого списка — сначала
# проверить через GET /tts?voice=...&text=... вживую.
YANDEX_TTS_VOICE=alena

# На будущее, если всё же понадобится Gemini/Claude (например, через
# отдельный релей за пределами России):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
