# Скопировать в .env для локального запуска (node --env-file=.env src/server.js)
# На сервере эти переменные задаются через pm2 (ecosystem.config.cjs), не файлом .env.

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3011

# Понадобится, когда переключимся на Claude (согласовано с руководством):
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
