# Скопировать в .env — и локально (node --env-file=.env src/server.js),
# и на сервере (ecosystem.config.cjs подключает этот же .env через
# --env-file). Сам .env в .gitignore, не коммитится.

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3011

# Понадобится, когда переключимся на Claude (согласовано с руководством):
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
