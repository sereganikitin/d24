<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Ds24Kiosk" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kiosk_accent</item>
        <item name="android:windowBackground">@color/kiosk_background</item>
    </style>

    <style name="Theme.Ds24Kiosk.Fullscreen" parent="Theme.Ds24Kiosk">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/black</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@android:color/black</item>
    </style>
</resources>
