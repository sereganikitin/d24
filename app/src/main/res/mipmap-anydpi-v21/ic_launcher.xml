        android:fillColor="#0B1220"
        android:pathData="M0,0 h108 v108 h-108 z" />
    <path
        android:fillColor="#3D7BF7"
        android:pathData="M54,24 L84,50 L78,50 L78,84 L60,84 L60,64 L48,64 L48,84 L30,84 L30,50 L24,50 Z" />
