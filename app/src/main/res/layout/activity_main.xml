<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiosk_background">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kiosk_background"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="@color/kiosk_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offlineRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/kiosk_text"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sessionExpiredBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@color/kiosk_accent"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/session_expired_hint"
        android:textColor="@color/kiosk_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!--
      Кнопки-подсказки (2-4 коротких варианта ответа, см.
      VoiceAssistant.Listener.onAssistantSaid) — над строкой
      маскот+пузырь, чтобы не перекрывать их. Дочерние Chip создаются
      в коде (MainActivity.renderAssistantOptions), не хардкодятся тут.
    -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/assistantOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="215dp"
        android:visibility="gone"
        app:chipSpacingHorizontal="8dp"
        app:singleLine="false" />

    <!--
      Строка "пузырь-подпись + маскот" — то, что ассистент сейчас
      говорит, текстом слева от персонажа (см. onAssistantSaid).
      Margin end/bottom — те же, что были у одинокого voiceAssistantButton
      до этой правки, чтобы маскот остался на своём месте.
    -->
    <LinearLayout
        android:id="@+id/assistantRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="100dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/assistantCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_speech_bubble"
            android:maxWidth="240dp"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/kiosk_background"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/voiceAssistantButton"
            android:layout_width="88dp"
            android:layout_height="105dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="@string/voice_assistant_button"
            app:lottie_rawRes="@raw/scout"
            app:lottie_loop="true"
            app:lottie_autoPlay="false" />
    </LinearLayout>

    <!--
      Скрытая зона обслуживания: удержание пальца ~3 сек в этом углу
      открывает диалог с ПИН. Незаметна для обычного жителя.
    -->
    <View
        android:id="@+id/adminGestureZone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end" />

</FrameLayout>
