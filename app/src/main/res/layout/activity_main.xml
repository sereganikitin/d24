<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiosk_background">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kiosk_background"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="@color/kiosk_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offlineRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/kiosk_text"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sessionExpiredBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@color/kiosk_accent"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/session_expired_hint"
        android:textColor="@color/kiosk_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/voiceAssistantButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:background="@drawable/bg_voice_fab"
        android:contentDescription="@string/voice_assistant_button"
        android:padding="18dp"
        android:src="@drawable/ic_mic" />

    <!--
      Скрытая зона обслуживания: удержание пальца ~3 сек в этом углу
      открывает диалог с ПИН. Незаметна для обычного жителя.
    -->
    <View
        android:id="@+id/adminGestureZone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end" />

</FrameLayout>
