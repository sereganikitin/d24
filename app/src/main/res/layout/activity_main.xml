<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiosk_background">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kiosk_background"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="@color/kiosk_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offlineRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/kiosk_text"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sessionExpiredBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@color/kiosk_accent"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/session_expired_hint"
        android:textColor="@color/kiosk_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!--
      Кнопка-триггер полноэкранного консьержа (см. conciergeWebView
      ниже) — просто круглая кнопка в акцентных цветах консьержа, без
      отдельного маскота/анимации, чтобы не смешивать два разных
      персонажа (сам консьерж со своей анимацией живёт внутри
      conciergeWebView). Гейт видимости — как и раньше, по экрану логина
      (см. MainActivity.refreshAuthState).
    -->
    <ImageButton
        android:id="@+id/voiceAssistantButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_concierge_trigger"
        android:contentDescription="@string/voice_assistant_button"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mic"
        android:visibility="gone" />

    <!--
      Полноэкранный голосовой консьерж — второй WebView со своей
      локальной страницей (assets/concierge/index.html), поверх
      основного WebView с lk.purehome.ru. Открывается тапом по
      voiceAssistantButton, закрывается по "Назад" внутри самой
      страницы (см. MainActivity.ConciergeBridge.onBack). Смотреть
      разметку/логику именно в assets/concierge/index.html — это не
      маленький оверлей, а полный самостоятельный экран.
    -->
    <WebView
        android:id="@+id/conciergeWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!--
      Скрытая зона обслуживания: удержание пальца ~3 сек в этом углу
      открывает диалог с ПИН. Незаметна для обычного жителя.
    -->
    <View
        android:id="@+id/adminGestureZone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end" />

</FrameLayout>
